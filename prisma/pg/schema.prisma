generator client {
  provider = "prisma-client-js"
  output   = "../generated/pg"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id                 String   @id @default(cuid())
  address            String   @unique
  encryptedPrivateKey Bytes
  encryptionIv       Bytes
  keyVersion         Int      @default(1)
  createdAt          DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  accounts      Account[]
  sessions      Session[]
  wallets       UserWallet[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DailyTransactionSummary {
  id        String   @id @default(cuid())
  day       DateTime @unique
  count     Int
  createdAt DateTime @default(now())
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  event     String
  sessionId String
  deviceId  String
  path      String?
  context   Json?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([sessionId])
}

model TrackWalletEvent {
  id            String   @id @default(cuid())
  address       String
  chainId       Int?
  chainName     String?
  connectorId   String?
  connectorName String?
  connectorType String?
  userAgent     String?
  timestamp     DateTime
  receivedAt    DateTime
  createdAt     DateTime @default(now())

  @@index([address])
  @@index([timestamp])
}

model Signup {
  id        String   @id @default(cuid())
  email     String   @unique
  region    String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String
  walletId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, walletId])
  @@index([walletId])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String
  key       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}

model WalletTransferLog {
  id             String   @id @default(cuid())
  walletId       String
  userId         String?
  chainId        Int
  toAddress      String
  amountWei      BigInt
  status         String
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([toAddress])
  @@index([idempotencyKey])
}

model RiskDecision {
  id        String   @id @default(cuid())
  action    String
  walletId  String?
  userId    String?
  score     Int
  decision  String
  reasons   Json?
  context   Json?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
