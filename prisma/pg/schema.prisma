generator client {
  provider = "prisma-client-js"
  output   = "../generated/pg"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id                 String   @id @default(cuid())
  address            String   @unique
  encryptedPrivateKey Bytes
  encryptionIv       Bytes
  keyVersion         Int      @default(1)
  createdAt          DateTime @default(now())
}
model DailyTransactionSummary {
  id        String   @id @default(cuid())
  day       DateTime @unique
  count     Int
  createdAt DateTime @default(now())
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  event     String
  sessionId String
  deviceId  String
  path      String?
  context   Json?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([sessionId])
}
