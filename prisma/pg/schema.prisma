// prisma/pg/schema.prisma

generator client {
  provider = "prisma-client-js"
  // from prisma/pg → prisma/generated/pg
  output   = "../generated/pg"
}

datasource db {
  provider = "postgresql"
  // URL is configured in prisma/pg/prisma.config.ts
}

model DailyTransactionSummary {
  id         String   @id @default(cuid())
  day        DateTime
  totalValue Float
  chain      String
  asset      String
}
