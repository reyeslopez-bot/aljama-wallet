generator client {
  provider = "prisma-client-js"
  output   = "../generated/pg"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id                  String   @id @default(cuid())
  accountRef          String   @unique
  chain               String   @default("EVM")
  address             String   @unique
  pubKey              String?
  keyType             String   @default("secp256k1")
  signerBackend       String   @default("local")
  vaultId             String   @default("public")
  derivationPath      String?
  policy              Json?
  pqcBinding          Json?
  pqcBindingHash      String?  @unique
  encryptedPrivateKey Bytes?
  encryptionIv        Bytes?
  keyVersion          Int?
  createdAt           DateTime @default(now())
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  accounts      Account[]
  sessions      Session[]
  wallets       UserWallet[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DailyTransactionSummary {
  id        String   @id @default(cuid())
  day       DateTime @unique
  count     Int
  createdAt DateTime @default(now())
}

model TelemetryEvent {
  id            String   @id @default(cuid())
  schemaVersion String   @default("1")
  event         String
  sessionId     String
  deviceId      String
  traceId       String
  path          String?
  context       Json?
  payload       Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([schemaVersion])
  @@index([sessionId])
  @@index([traceId])
}

model TrackWalletEvent {
  id            String   @id @default(cuid())
  address       String
  chainId       Int?
  chainName     String?
  connectorId   String?
  connectorName String?
  connectorType String?
  userAgent     String?
  timestamp     DateTime
  receivedAt    DateTime
  createdAt     DateTime @default(now())

  @@index([address])
  @@index([timestamp])
}

model Signup {
  id        String   @id @default(cuid())
  email     String   @unique
  region    String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ContactRequest {
  id                 String   @id @default(cuid())
  userId             String?
  name               String?
  email              String
  category           String
  message            String
  locale             String?
  source             String?
  pagePath           String?
  status             String   @default("received")
  requestId          String?
  traceId            String?
  confirmationSentAt DateTime?
  internalNotifiedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String
  walletId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, walletId])
  @@index([walletId])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String
  key       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}

model WalletTransferLog {
  id                   String    @id @default(cuid())
  walletId             String
  userId               String?
  chainId              Int
  toAddress            String
  amountWei            BigInt
  status               String
  idempotencyKey       String
  traceId              String
  txHash               String?
  nonce                String?
  txType               String?
  data                 String?
  gasLimit             String?
  gasPrice             String?
  maxFeePerGas         String?
  maxPriorityFeePerGas String?
  gasUsed              String?
  blockHeight          BigInt?
  blockHash            String?
  confirmationCount    Int       @default(0)
  replacesTxHash       String?
  replacedByTxHash     String?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([walletId, createdAt])
  @@index([walletId, chainId, nonce])
  @@index([userId, createdAt])
  @@index([toAddress])
  @@index([idempotencyKey])
  @@index([traceId])
  @@index([txHash])
  @@index([status, createdAt])
  @@index([replacesTxHash])
}

model WalletSigningIntent {
  id                 String   @id @default(cuid())
  chain              String   @default("EVM")
  actionType         String
  status             String
  walletId           String
  userId             String?
  chainId            Int
  idempotencyKey     String
  traceId            String
  transferLogId      String?
  txPayload          Json?
  txPayloadRef       String?
  txPayloadSizeBytes Int?
  signedPayload      String?
  txHash             String?
  errorCode          String?
  errorDetails       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([walletId, idempotencyKey, actionType])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([traceId])
  @@index([txHash])
  @@index([transferLogId])
}

model WalletNonceState {
  walletId  String
  chainId   Int
  nextNonce Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([walletId, chainId])
  @@index([updatedAt])
}

model NonceReservation {
  id        String   @id @default(cuid())
  walletId  String
  chainId   Int
  nonce     Int
  actionId  String
  status    String
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([walletId, chainId, nonce])
  @@unique([walletId, chainId, actionId])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([txHash])
}

model RiskDecision {
  id        String   @id @default(cuid())
  action    String
  walletId  String?
  userId    String?
  score     Int
  decision  String
  reasons   Json?
  context   Json?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model ReconciliationIssue {
  id          String    @id @default(cuid())
  scope       String
  kind        String
  refId       String
  status      String    @default("open")
  severity    String    @default("high")
  traceId     String?
  summary     String?
  details     Json?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([scope, kind, refId])
  @@index([status, updatedAt])
  @@index([scope, status, updatedAt])
  @@index([refId])
  @@index([traceId])
}

model SecuritySignalEvent {
  id                String   @id
  schemaVersion     String   @default("1")
  source            String
  route             String?
  outcome           String
  statusCode        Int?
  ipHash            String?
  userId            String?
  sessionId         String?
  deviceId          String?
  principal         String?
  country           String?
  latitude          Float?
  longitude         Float?
  userAgent         String?
  producerId        String?
  producerType      String?
  signatureVerified Boolean  @default(false)
  ingestVersion     String?
  traceId           String
  transport         String
  details           Json?
  detectedAt        DateTime
  ingestedAt        DateTime @default(now())

  anomalies SecurityAnomalyEvent[]

  @@index([detectedAt])
  @@index([schemaVersion])
  @@index([source, detectedAt])
  @@index([outcome, detectedAt])
  @@index([ipHash, detectedAt])
  @@index([producerId, detectedAt])
  @@index([traceId])
}

model SecurityAnomalyEvent {
  id         String   @id
  signalId   String
  ruleId     String
  ruleType   String
  severity   String
  repetitive Boolean
  score      Int
  summary    String
  details    Json?
  detectedAt DateTime
  ingestedAt DateTime @default(now())

  signal SecuritySignalEvent @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([detectedAt])
  @@index([ruleId, detectedAt])
  @@index([severity, detectedAt])
  @@index([signalId])
}

model SecurityAlertEvent {
  id                 String   @id
  ruleId             String
  source             String
  severity           String
  baseSeverity       String
  priority           String
  repetitive         Boolean
  deduped            Boolean
  duplicateCount     Int
  dedupKey           String
  dedupWindowMs      Int
  dedupTtlMs         Int
  dedupEscalated     Boolean
  fingerprint        String
  title              String
  description        String
  runbookId          String?
  runbookUrl         String?
  context            Json?
  containmentActions Json?
  delivered          Json?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([priority, createdAt])
  @@index([ruleId, createdAt])
  @@index([source, createdAt])
}

model XrplAction {
  id             String   @id
  action         String
  status         String
  userId         String?
  networkId      String
  account        String
  idempotencyKey String
  traceId        String
  txHash         String?
  engineResult   String?
  details        Json?
  createdAt      DateTime
  updatedAt      DateTime

  events             XrplActionEvent[]
  /// A payment action can map to one audited issuer distribution attempt.
  /// Keeping the relation optional lets older XRPL actions remain valid.
  issuerDistribution XrplIssuerDistribution?

  @@index([updatedAt])
  @@index([networkId, updatedAt])
  @@index([idempotencyKey])
  @@index([traceId])
  @@index([userId, updatedAt])
}

model XrplActionEvent {
  id           String   @id @default(cuid())
  actionId     String
  eventType    String
  status       String
  txHash       String?
  engineResult String?
  details      Json?
  occurredAt   DateTime @default(now())

  action XrplAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, occurredAt])
  @@index([occurredAt])
}

/// One issuer program represents the account-level operating policy for an XRPL
/// issuer on a single network. This is intentionally separate from individual
/// currencies because AccountSet settings apply to the issuer account itself,
/// not to a specific token.
model XrplIssuerProgram {
  id                           String   @id @default(cuid())
  networkId                    String
  issuerAccount                String
  distributorAccount           String?
  status                       String   @default("active")
  name                         String?
  domain                       String?
  transferFeeBps               Int?
  tickSize                     Int?
  requiresAuthorizedTrustlines Boolean  @default(true)
  allowDistributions           Boolean  @default(true)
  metadata                     Json?
  createdByUserId              String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  assets        XrplIssuerAsset[]
  distributions XrplIssuerDistribution[]

  /// There should only be one program per issuer account on a network.
  @@unique([networkId, issuerAccount])
  @@index([status, updatedAt])
  @@index([networkId, status, updatedAt])
}

/// Assets capture token-specific policy that the XRPL ledger itself does not
/// model for us, such as whether distributions are currently enabled or whether
/// a human approval step is mandatory before we authorize a holder.
model XrplIssuerAsset {
  id                    String   @id @default(cuid())
  programId             String
  currency              String
  status                String   @default("active")
  displayName           String?
  precision             Int?
  trustlineLimit        String?
  distributionsEnabled  Boolean  @default(true)
  requireHolderApproval Boolean  @default(true)
  maxDistributionValue  String?
  metadata              Json?
  createdByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  program       XrplIssuerProgram        @relation(fields: [programId], references: [id], onDelete: Cascade)
  holders       XrplIssuerHolder[]
  distributions XrplIssuerDistribution[]

  /// Currency codes are only unique within the issuer program. Reusing the same
  /// code across networks or issuers is allowed and expected.
  @@unique([programId, currency])
  @@index([status, updatedAt])
}

/// Holder rows are our internal compliance state. XRPL authorization alone only
/// says "a TrustSet was submitted"; this table answers "was this wallet
/// approved, revoked, or rejected under our off-ledger policy?"
model XrplIssuerHolder {
  id                 String    @id @default(cuid())
  assetId            String
  holderAddress      String
  status             String    @default("pending")
  approvedByUserId   String?
  approvedAt         DateTime?
  revokedAt          DateTime?
  lastAuthorizedAt   DateTime?
  lastDistributionAt DateTime?
  notes              String?
  reviewContext      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  asset         XrplIssuerAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  distributions XrplIssuerDistribution[]

  /// A wallet should have one authoritative policy row per asset.
  @@unique([assetId, holderAddress])
  @@index([holderAddress])
  @@index([status, updatedAt])
}

/// Every issuer-side payment attempt is persisted here so the app has an
/// auditable source of truth that survives XRPL action logs, retries, and
/// future reconciliation work.
model XrplIssuerDistribution {
  id                 String    @id @default(cuid())
  programId          String
  assetId            String
  holderId           String?
  actionId           String?   @unique
  destinationAddress String
  amount             String
  status             String    @default("queued")
  idempotencyKey     String?
  txHash             String?
  failureCode        String?
  requestedByUserId  String?
  requestedAt        DateTime  @default(now())
  submittedAt        DateTime?
  validatedAt        DateTime?
  details            Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  program XrplIssuerProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  asset   XrplIssuerAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holder  XrplIssuerHolder? @relation(fields: [holderId], references: [id], onDelete: SetNull)
  action  XrplAction?       @relation(fields: [actionId], references: [id], onDelete: SetNull)

  @@index([programId, createdAt])
  @@index([assetId, createdAt])
  @@index([holderId, createdAt])
  @@index([status, updatedAt])
  @@index([txHash])
}
