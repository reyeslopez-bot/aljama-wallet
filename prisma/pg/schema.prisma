generator client {
  provider = "prisma-client-js"
  output   = "../generated/pg"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id                 String   @id @default(cuid())
  address            String   @unique
  encryptedPrivateKey Bytes
  encryptionIv       Bytes
  keyVersion         Int      @default(1)
  createdAt          DateTime @default(now())
}
