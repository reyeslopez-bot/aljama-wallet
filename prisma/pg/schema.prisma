generator client {
  provider = "prisma-client-js"
  output   = "../generated/pg"
}

datasource db {
  provider = "postgresql"
}

model Wallet {
  id                  String   @id @default(cuid())
  accountRef          String   @unique
  chain               String   @default("EVM")
  address             String   @unique
  pubKey              String?
  keyType             String   @default("secp256k1")
  signerBackend       String   @default("local")
  vaultId             String   @default("public")
  derivationPath      String?
  policy              Json?
  pqcBinding          Json?
  pqcBindingHash      String?  @unique
  encryptedPrivateKey Bytes?
  encryptionIv        Bytes?
  keyVersion          Int?
  createdAt           DateTime @default(now())
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String
  accounts      Account[]
  sessions      Session[]
  wallets       UserWallet[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DailyTransactionSummary {
  id        String   @id @default(cuid())
  day       DateTime @unique
  count     Int
  createdAt DateTime @default(now())
}

model TelemetryEvent {
  id        String   @id @default(cuid())
  event     String
  sessionId String
  deviceId  String
  path      String?
  context   Json?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([sessionId])
}

model TrackWalletEvent {
  id            String   @id @default(cuid())
  address       String
  chainId       Int?
  chainName     String?
  connectorId   String?
  connectorName String?
  connectorType String?
  userAgent     String?
  timestamp     DateTime
  receivedAt    DateTime
  createdAt     DateTime @default(now())

  @@index([address])
  @@index([timestamp])
}

model Signup {
  id        String   @id @default(cuid())
  email     String   @unique
  region    String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model UserWallet {
  id        String   @id @default(cuid())
  userId    String
  walletId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, walletId])
  @@index([walletId])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String
  key       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}

model WalletTransferLog {
  id                   String    @id @default(cuid())
  walletId             String
  userId               String?
  chainId              Int
  toAddress            String
  amountWei            BigInt
  status               String
  idempotencyKey       String
  txHash               String?
  nonce                String?
  txType               String?
  data                 String?
  gasLimit             String?
  gasPrice             String?
  maxFeePerGas         String?
  maxPriorityFeePerGas String?
  gasUsed              String?
  blockHeight          BigInt?
  blockHash            String?
  confirmationCount    Int       @default(0)
  replacesTxHash       String?
  replacedByTxHash     String?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([walletId, createdAt])
  @@index([walletId, chainId, nonce])
  @@index([userId, createdAt])
  @@index([toAddress])
  @@index([idempotencyKey])
  @@index([txHash])
  @@index([status, createdAt])
  @@index([replacesTxHash])
}

model WalletSigningIntent {
  id             String   @id @default(cuid())
  chain          String   @default("EVM")
  actionType     String
  status         String
  walletId       String
  userId         String?
  chainId        Int
  idempotencyKey String
  traceId        String
  transferLogId  String?
  txPayload      Json
  signedPayload  String?
  txHash         String?
  errorCode      String?
  errorDetails   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([walletId, idempotencyKey, actionType])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([traceId])
  @@index([txHash])
  @@index([transferLogId])
}

model WalletNonceState {
  walletId  String
  chainId   Int
  nextNonce Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([walletId, chainId])
  @@index([updatedAt])
}

model NonceReservation {
  id        String   @id @default(cuid())
  walletId  String
  chainId   Int
  nonce     Int
  actionId  String
  status    String
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([walletId, chainId, nonce])
  @@unique([walletId, chainId, actionId])
  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([txHash])
}

model RiskDecision {
  id        String   @id @default(cuid())
  action    String
  walletId  String?
  userId    String?
  score     Int
  decision  String
  reasons   Json?
  context   Json?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model SecuritySignalEvent {
  id                String   @id
  source            String
  route             String?
  outcome           String
  statusCode        Int?
  ipHash            String?
  userId            String?
  sessionId         String?
  deviceId          String?
  principal         String?
  country           String?
  latitude          Float?
  longitude         Float?
  userAgent         String?
  producerId        String?
  producerType      String?
  signatureVerified Boolean  @default(false)
  ingestVersion     String?
  transport         String
  details           Json?
  detectedAt        DateTime
  ingestedAt        DateTime @default(now())

  anomalies SecurityAnomalyEvent[]

  @@index([detectedAt])
  @@index([source, detectedAt])
  @@index([outcome, detectedAt])
  @@index([ipHash, detectedAt])
  @@index([producerId, detectedAt])
}

model SecurityAnomalyEvent {
  id         String   @id
  signalId   String
  ruleId     String
  ruleType   String
  severity   String
  repetitive Boolean
  score      Int
  summary    String
  details    Json?
  detectedAt DateTime
  ingestedAt DateTime @default(now())

  signal SecuritySignalEvent @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([detectedAt])
  @@index([ruleId, detectedAt])
  @@index([severity, detectedAt])
  @@index([signalId])
}

model SecurityAlertEvent {
  id                 String   @id
  ruleId             String
  source             String
  severity           String
  baseSeverity       String
  priority           String
  repetitive         Boolean
  deduped            Boolean
  duplicateCount     Int
  dedupKey           String
  dedupWindowMs      Int
  dedupTtlMs         Int
  dedupEscalated     Boolean
  fingerprint        String
  title              String
  description        String
  runbookId          String?
  runbookUrl         String?
  context            Json?
  containmentActions Json?
  delivered          Json?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([severity, createdAt])
  @@index([priority, createdAt])
  @@index([ruleId, createdAt])
  @@index([source, createdAt])
}

model XrplAction {
  id             String   @id
  action         String
  status         String
  userId         String?
  networkId      String
  account        String
  idempotencyKey String
  txHash         String?
  engineResult   String?
  details        Json?
  createdAt      DateTime
  updatedAt      DateTime

  events XrplActionEvent[]

  @@index([updatedAt])
  @@index([networkId, updatedAt])
  @@index([idempotencyKey])
  @@index([userId, updatedAt])
}

model XrplActionEvent {
  id           String   @id @default(cuid())
  actionId     String
  eventType    String
  status       String
  txHash       String?
  engineResult String?
  details      Json?
  occurredAt   DateTime @default(now())

  action XrplAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, occurredAt])
  @@index([occurredAt])
}
