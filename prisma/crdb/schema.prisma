generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-crdb"
}

datasource db {
  provider = "cockroachdb"
  // url moved to prisma.config.ts in Prisma 7
}

model Wallet {
  id                  String        @id @default(cuid())
  accountRef          String        @unique
  chain               String        @default("EVM")
  address             String        @unique
  pubKey              String?
  keyType             String        @default("secp256k1")
  signerBackend       String        @default("local")
  vaultId             String        @default("public")
  derivationPath      String?
  policy              Json?
  pqcBinding          Json?
  pqcBindingHash      String?       @unique
  encryptedPrivateKey Bytes?
  encryptionIv        Bytes?
  keyVersion          Int?
  createdAt           DateTime      @default(now())

  sentTransactions     Transaction[] @relation("TxFromWallet")
  receivedTransactions Transaction[] @relation("TxToWallet")
  outboundChainTransactions ChainTransaction[] @relation("ChainTxFromWallet")
  inboundChainTransactions  ChainTransaction[] @relation("ChainTxToWallet")
  sentTokenTransfers        TokenTransfer[]    @relation("TokenTransferFromWallet")
  receivedTokenTransfers    TokenTransfer[]    @relation("TokenTransferToWallet")
  pqcAnchors           WalletPqcAnchor[]
}

model ChainTransaction {
  id             String   @id @default(cuid())
  chainType      String   @default("EVM")
  networkId      String
  txHash         String
  nonce          String?
  status         String
  txType         String   @default("transfer")
  asset          String   @default("native")
  valueBaseUnits BigInt
  gasLimit       String?
  gasPrice       String?
  maxFeePerGas   String?
  maxPriorityFeePerGas String?
  gasUsed        String?
  blockHeight    BigInt?
  blockHash      String?
  fromAddress    String
  toAddress      String
  data           String?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  replacedByTxHash String?

  fromWalletId String
  toWalletId   String?

  fromWallet Wallet  @relation("ChainTxFromWallet", fields: [fromWalletId], references: [id])
  toWallet   Wallet? @relation("ChainTxToWallet", fields: [toWalletId], references: [id])

  @@unique([chainType, networkId, txHash])
  @@index([fromWalletId, chainType, networkId, createdAt])
  @@index([toWalletId, chainType, networkId, createdAt])
  @@index([toAddress, chainType, networkId, createdAt])
  @@index([fromWalletId, chainType, networkId, nonce])
  @@index([status, createdAt])
  @@index([confirmedAt])
}

model TokenTransfer {
  id             String   @id @default(cuid())
  chainType      String   @default("EVM")
  networkId      String
  txHash         String
  logIndex       Int
  contractAddress String
  tokenStandard  String?
  assetSymbol    String?
  amountBaseUnits String?
  tokenId        String?
  fromAddress    String
  toAddress      String
  blockHeight    BigInt?
  blockHash      String?
  confirmedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromWalletId String?
  toWalletId   String?

  fromWallet Wallet? @relation("TokenTransferFromWallet", fields: [fromWalletId], references: [id])
  toWallet   Wallet? @relation("TokenTransferToWallet", fields: [toWalletId], references: [id])

  @@unique([chainType, networkId, txHash, logIndex])
  @@index([fromWalletId, createdAt])
  @@index([toWalletId, createdAt])
  @@index([contractAddress, createdAt])
  @@index([txHash])
}

model WalletPqcAnchor {
  id              String   @id @default(cuid())
  walletId        String
  chainType       String
  networkId       String
  registryAddress String?
  bindingHash     String
  statementHash   String
  signatureHash   String
  publicKeyHash   String
  uri             String
  uriHash         String
  txHash          String
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([chainType, networkId, txHash])
  @@index([walletId, createdAt])
}

model Transaction {
  id         String   @id @default(cuid())
  blockchain String
  asset      String
  valueWei   BigInt
  createdAt  DateTime @default(now())

  fromWalletId String
  toWalletId   String

  fromWallet Wallet @relation("TxFromWallet", fields: [fromWalletId], references: [id])
  toWallet   Wallet @relation("TxToWallet", fields: [toWalletId], references: [id])

  @@index([blockchain, fromWalletId, createdAt])
  @@index([blockchain, toWalletId, createdAt])
  @@index([asset])
}
