generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-crdb"
}

datasource db {
  provider = "cockroachdb"
  // url moved to prisma.config.ts in Prisma 7
}

model Wallet {
  id                  String        @id @default(cuid())
  accountRef          String        @unique
  chain               String        @default("EVM")
  address             String        @unique
  pubKey              String?
  keyType             String        @default("secp256k1")
  signerBackend       String        @default("local")
  vaultId             String        @default("public")
  derivationPath      String?
  policy              Json?
  pqcBinding          Json?
  pqcBindingHash      String?       @unique
  encryptedPrivateKey Bytes?
  encryptionIv        Bytes?
  keyVersion          Int?
  createdAt           DateTime      @default(now())

  sentTransactions     Transaction[] @relation("TxFromWallet")
  receivedTransactions Transaction[] @relation("TxToWallet")
  pqcAnchors           WalletPqcAnchor[]
}

model WalletPqcAnchor {
  id              String   @id @default(cuid())
  walletId        String
  chainType       String
  networkId       String
  registryAddress String?
  bindingHash     String
  statementHash   String
  signatureHash   String
  publicKeyHash   String
  uri             String
  uriHash         String
  txHash          String
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([chainType, networkId, txHash])
  @@index([walletId, createdAt])
}

model Transaction {
  id         String   @id @default(cuid())
  blockchain String
  asset      String
  valueWei   BigInt
  createdAt  DateTime @default(now())

  fromWalletId String
  toWalletId   String

  fromWallet Wallet @relation("TxFromWallet", fields: [fromWalletId], references: [id])
  toWallet   Wallet @relation("TxToWallet", fields: [toWalletId], references: [id])

  @@index([blockchain, fromWalletId, createdAt])
  @@index([blockchain, toWalletId, createdAt])
  @@index([asset])
}
