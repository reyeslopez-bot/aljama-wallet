# syntax=docker/dockerfile:1.7

# ---------- base ----------
FROM node:25.4.0 AS base
WORKDIR /workspace

ENV NEXT_TELEMETRY_DISABLED=1 \
    COREPACK_ENABLE_STRICT=1 \
    PNPM_HOME=/usr/local/pnpm \
    PATH="/usr/local/pnpm:/workspace/node_modules/.bin:${PATH}"

RUN apt-get update && apt-get install -y -qq \
      git curl vim neovim bash xxd xclip \
    && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=10.28.1
RUN npm i -g pnpm@${PNPM_VERSION}

# ---------- dev ----------
FROM base AS dev
WORKDIR /workspace

ENV NODE_ENV=development PORT=2998 HOSTNAME=0.0.0.0
EXPOSE 2998

# Optional: keep for metadata only (no install)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

CMD ["bash","-lc","pnpm dev --port ${PORT:-2998} --hostname 0.0.0.0"]

# ---------- builder ----------
FROM base AS builder
WORKDIR /workspace
ARG NEXTAUTH_SECRET=container-build-nextauth-secret
ARG NEXTAUTH_URL=http://127.0.0.1:3000
ENV NEXTAUTH_SECRET=${NEXTAUTH_SECRET} \
    NEXTAUTH_URL=${NEXTAUTH_URL}

# 1. Install deps (no app source yet)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm config set store-dir /root/.pnpm-store && \
    pnpm config set registry https://registry.npmjs.org/ && \
    for attempt in 1 2 3; do \
      CI=true PNPM_CONFIRM_DELETE=1 pnpm install --frozen-lockfile && break; \
      if [ "$attempt" -eq 3 ]; then \
        echo "pnpm install failed after 3 attempts"; \
        exit 1; \
      fi; \
      sleep $((attempt * 15)); \
    done

# 2. Copy source (including prisma/)
COPY . .

RUN pnpm prisma generate --schema=prisma/crdb/schema.prisma \
    && pnpm prisma generate --schema=prisma/pg/schema.prisma \
    && echo "=== prisma/generated tree ===" \
    && ls -la prisma/generated \
    && echo "=== prisma-crdb files ===" \
    && ls -la prisma/generated/prisma-crdb \
    && test -f prisma/generated/prisma-crdb/index.d.ts
# 3. Build Next
RUN pnpm build \
    && test -f .next/standalone/server.js

# ---------- prod ----------
FROM node:25.4.0-slim AS prod
WORKDIR /workspace

ENV NODE_ENV=production \
    PORT=2999 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /workspace/.next/standalone ./
COPY --from=builder /workspace/.next/static ./.next/static
COPY --from=builder /workspace/public ./public
COPY --from=builder /workspace/prisma/generated ./prisma/generated

EXPOSE 2999
CMD ["node","server.js"]

# ---------- ci ----------
FROM base AS ci
WORKDIR /workspace

ENV NODE_ENV=development \
    PORT=2998 \
    HOSTNAME=0.0.0.0

CMD ["bash"]
