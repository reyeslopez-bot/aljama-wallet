# syntax=docker/dockerfile:1.7

# ---------- base ----------
FROM node:24.3.0 AS base
WORKDIR /workspace

ENV NEXT_TELEMETRY_DISABLED=1 \
    COREPACK_ENABLE_STRICT=1 \
    PNPM_HOME=/usr/local/pnpm \
    PATH="/usr/local/pnpm:/workspace/node_modules/.bin:${PATH}"

RUN apt-get update && apt-get install -y -qq \
      git curl vim neovim bash xxd xclip \
    && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=10.27.0
RUN corepack enable \
 && corepack prepare pnpm@${PNPM_VERSION} --activate

# ---------- dev ----------
FROM base AS dev
WORKDIR /workspace

ENV NODE_ENV=development PORT=2998 HOSTNAME=0.0.0.0
EXPOSE 2998

# Optional: keep for metadata only (no install)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

CMD ["bash","-lc","pnpm dev --port ${PORT:-2998} --hostname 0.0.0.0"]

# ---------- builder ----------
FROM base AS builder
WORKDIR /workspace

# 1. Install deps (no prisma schema yet)
COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm config set store-dir /root/.pnpm-store && \
    CI=true PNPM_CONFIRM_DELETE=1 pnpm install --frozen-lockfile

# 2. Copy source (including prisma/)
COPY . .

RUN pnpm prisma generate --schema=prisma/crdb/schema.prisma \
    && pnpm prisma generate --schema=prisma/pg/schema.prisma \
    && echo "=== prisma/generated tree ===" \
    && ls -la prisma/generated \
    && echo "=== prisma-crdb files ===" \
    && ls -la prisma/generated/prisma-crdb \
    && test -f prisma/generated/prisma-crdb/index.d.ts
# 3. Build Next
RUN pnpm build

# ---------- prod ----------
FROM base AS prod
WORKDIR /workspace

ENV NODE_ENV=production \
    PORT=2999 \
    HOSTNAME=0.0.0.0

COPY --from=builder /workspace/package.json ./package.json
COPY --from=builder /workspace/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /workspace/.next ./.next
COPY --from=builder /workspace/public ./public
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/prisma ./prisma

EXPOSE 2999
CMD ["pnpm","start"]
