{
  "name": "aljama-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "eslint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prisma:generate": "pnpm prisma:generate:crdb && pnpm prisma:generate:pg",
    "prisma:generate:crdb": "prisma generate --schema=prisma/crdb/schema.prisma",
    "prisma:generate:pg": "prisma generate --schema=prisma/pg/schema.prisma",
    "prisma:format": "pnpm prisma:format:crdb && pnpm prisma:format:pg",
    "prisma:format:crdb": "prisma format --schema=prisma/crdb/schema.prisma",
    "prisma:format:pg": "prisma format --schema=prisma/pg/schema.prisma",
    "prisma:migrate:deploy:pg": "prisma migrate deploy --schema=prisma/pg/schema.prisma"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@prisma/client": "7.1.0",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "5.90.12",
    "@wagmi/connectors": "7.0.2",
    "clsx": "^2.1.1",
    "ethers": "6.16.0",
    "framer-motion": "12.23.25",
    "pino-pretty": "^13.1.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "viem": "2.41.2",
    "wagmi": "3.1.0",
    "xrpl": "^4.4.3",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.0.7",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.7",
    "jsdom": "^27.2.0",
    "knip": "^5.71.0",
    "next": "16.0.7",
    "postcss": "8.5.6",
    "postcss-load-config": "^6.0.1",
    "prisma": "7.1.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3",
      "wagmi": "3.1.0",
      "viem": "2.41.2",
      "@wagmi/connectors": "7.0.2",
      "@base-org/account": "2.4.2",
      "@walletconnect/ethereum-provider": "2.21.1",
      "@walletconnect/universal-provider": "2.21.1",
      "@walletconnect/sign-client": "2.21.1",
      "abitype@1.0.8>zod": "^3.22.4"
    },
    "peerDependencyRules": {
      "allowAny": [
        "zod"
      ],
      "ignoreMissing": [
        "zod"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "es5-ext",
      "esbuild",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@10.26.1"
}
