{
  "name": "aljama-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prisma:generate:crdb": "prisma generate --schema=prisma/crdb/schema.prisma",
    "prisma:generate:pg": "prisma generate --schema=prisma/pg/schema.prisma",
    "prisma:generate": "pnpm prisma:generate:crdb && pnpm prisma:generate:pg"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@prisma/client": "6.19.0",
    "@tanstack/react-query": "5.90.9",
    "@wagmi/connectors": "6.1.4",
    "clsx": "^2.1.1",
    "ethers": "6.13.7",
    "framer-motion": "10.18.0",
    "pino-pretty": "^13.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.39.0",
    "wagmi": "2.19.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.16.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "jsdom": "^27.2.0",
    "knip": "^5.70.1",
    "next": "15.3.2",
    "postcss": "8.5.3",
    "postcss-load-config": "^6.0.1",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.3",
      "@types/react-dom": "19.1.3",
      "wagmi": "2.19.3",
      "viem": "2.39.0",
      "@wagmi/connectors": "6.1.4",
      "@base-org/account": "2.4.2",
      "@walletconnect/ethereum-provider": "2.21.1",
      "@walletconnect/universal-provider": "2.21.1",
      "@walletconnect/sign-client": "2.21.1",
      "abitype@1.0.8>zod": "^3.22.4"
    },
    "peerDependencyRules": {
      "allowAny": [
        "zod"
      ],
      "ignoreMissing": [
        "zod"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "es5-ext",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
