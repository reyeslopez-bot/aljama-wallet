{
  "name": "aljama-wallet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate:crdb": "prisma generate --schema=prisma/crdb/schema.prisma",
    "prisma:generate:pg":   "prisma generate --schema=prisma/pg/schema.prisma",
    "prisma:generate":      "pnpm prisma:generate:crdb && pnpm prisma:generate:pg"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@prisma/client": "6.19.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tanstack/react-query": "5.90.9",
    "@wagmi/connectors": "6.1.4",
    "clsx": "^2.1.1",
    "connectkit": "1.9.1",
    "ethers": "6.13.7",
    "framer-motion": "10.18.0",
    "pino-pretty": "^13.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.39.0",
    "wagmi": "2.19.3"
  },
  "devDependencies": {
    "eslint": "9.16.0",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "autoprefixer": "10.4.20",
    "next": "15.3.2",
    "postcss": "8.5.3",
    "prisma": "6.19.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.3",
      "@types/react-dom": "19.1.3",
      "wagmi": "2.19.3",
      "viem": "2.39.0",
      "@wagmi/connectors": "6.1.4",
      "@base-org/account": "2.4.2",
      "@walletconnect/ethereum-provider": "2.21.1",
      "@walletconnect/universal-provider": "2.21.1",
      "@walletconnect/sign-client": "2.21.1",
      "abitype@1.0.8>zod": "^3.22.4"
    },
    "peerDependencyRules": {
      "allowAny": [
        "zod"
      ],
      "ignoreMissing": [
        "zod"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "es5-ext",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@10.21.0"
}
