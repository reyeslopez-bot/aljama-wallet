{
  "name": "aljama-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm prisma:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "test": "NODE_ENV=test vitest --run",
    "test:watch": "NODE_ENV=test vitest",
    "prisma:generate": "pnpm prisma:generate:crdb && pnpm prisma:generate:pg",
    "prisma:generate:crdb": "prisma generate --schema=prisma/crdb/schema.prisma",
    "prisma:generate:pg": "prisma generate --schema=prisma/pg/schema.prisma",
    "prisma:format": "pnpm prisma:format:crdb && pnpm prisma:format:pg",
    "prisma:format:crdb": "prisma format --schema=prisma/crdb/schema.prisma",
    "prisma:format:pg": "prisma format --schema=prisma/pg/schema.prisma",
    "prisma:migrate:deploy:pg": "prisma migrate deploy --schema=prisma/pg/schema.prisma",
    "security:migrate-wallet-keys": "tsx scripts/migrate-wallet-encryption.ts"
  },
  "dependencies": {
    "@base-org/account": "2.4.2",
    "@coinbase/wallet-sdk": "^4.3.7",
    "@gemini-wallet/core": "^0.3.2",
    "@metamask/sdk": "^0.34.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@tanstack/react-query": "5.90.12",
    "@walletconnect/ethereum-provider": "2.21.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "ethers": "6.16.0",
    "framer-motion": "12.23.25",
    "mapbox-gl": "^3.18.1",
    "next-auth": "^4.24.7",
    "next-intl": "^4.7.0",
    "pg": "^8.17.2",
    "pino": "^10.1.0",
    "porto": "^0.2.37",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "2.41.2",
    "wagmi": "3.4.2",
    "xrpl": "^4.4.3",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.1.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/react": "16.3.2",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "24.x",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "10.4.22",
    "dotenv": "^17.2.3",
    "eslint": "9.39.1",
    "jsdom": "^27.2.0",
    "knip": "^5.71.0",
    "next": "16.1.0",
    "postcss": "8.5.6",
    "prisma": "^7.3.0",
    "tailwindcss": "4.1.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.3",
      "@types/react-dom": "19.2.3",
      "wagmi": "3.4.2",
      "viem": "2.41.2",
      "@wagmi/connectors": "7.1.6",
      "@wagmi/core": "3.3.2",
      "@base-org/account": "2.4.2",
      "@walletconnect/ethereum-provider": "2.23.4",
      "@walletconnect/universal-provider": "2.23.4",
      "@walletconnect/sign-client": "2.23.4",
      "abitype@1.0.8>zod": "^3.22.4",
      "@metamask/sdk": "0.34.0",
      "@paulmillr/qr@": "0.3.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "zod"
      ],
      "ignoreMissing": [
        "zod"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "es5-ext",
      "esbuild",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
