{
  "name": "aljama-wallet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40",
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port ${PORT:-2998}",
    "dev:check": "tsc --noEmit",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-2999}",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "generate:crdb": "prisma generate --schema=prisma/crdb/schema.prisma",
    "generate:pg": "prisma generate --schema=prisma/pg/schema.prisma",
    "migrate:crdb": "prisma migrate dev --schema=prisma/crdb/schema.prisma",
    "migrate:pg": "prisma migrate dev --schema=prisma/pg/schema.prisma",
    "test:db": "ts-node scripts/test-db.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.8.1",
    "@tanstack/react-query": "^5.90.7",
    "alchemy-sdk": "^3.6.1",
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.0",
    "ethers": "^6.13.7",
    "framer-motion": "^10.12.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.23.2",
    "wagmi": "2.19.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "next": "15.3.2",
    "postcss": "^8",
    "prisma": "^6.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.3",
      "@types/react-dom": "19.1.3",

      "wagmi": "2.19.3",
      "viem": "2.23.2",

      "@walletconnect/ethereum-provider": "2.21.1",
      "@walletconnect/universal-provider": "2.21.1",
      "@walletconnect/sign-client": "2.21.1",

      "abitype@1.0.8>zod": "^3.22.4"
    },
    "peerDependencyRules": {
      "allowAny": ["zod"],
      "ignoreMissing": ["zod"]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "es5-ext",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
