{
  "name": "aljama-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "cross-env AUTH_MODE=memory NEXTAUTH_URL=http://localhost:2998 next dev --turbopack",
    "build": "pnpm prisma:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "test": "cross-env NODE_ENV=test vitest --run",
    "test:guardrails": "cross-env NODE_ENV=test vitest --run tests/invariants tests/app/api tests/lib/security/api-route.test.ts tests/services/security-anomaly.service.test.ts tests/services/security-alert.service.test.ts tests/components/home/HomeContent.test.tsx tests/components/home/XrplTradeDesk.test.tsx tests/components/ui/MapboxMap.test.tsx",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:frontend:components": "cross-env NODE_ENV=test vitest --run --config vitest.components.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit",
    "test:e2e:devices": "cross-env PLAYWRIGHT_EXTENDED_DEVICES=true playwright test tests/e2e/home.mobile.spec.ts --workers=1 --project=iphone-13 --project=pixel-7 --project=iphone-15-pro --project=galaxy-s24 --project=ipad-pro-11 --project=galaxy-tab-s9",
    "test:e2e:multi-browser": "playwright test tests/e2e/home.cross-browser.spec.ts --workers=1 --project=chromium --project=firefox --project=webkit",
    "test:e2e:real-backend": "cross-env PLAYWRIGHT_INCLUDE_PRODLIKE=true PLAYWRIGHT_REAL_BACKEND=true playwright test tests/e2e/home.production.spec.ts --project=chromium",
    "test:e2e:visual": "playwright test tests/e2e/home.frontend.spec.ts --project=chromium",
    "test:e2e:visual:update": "playwright test tests/e2e/home.frontend.spec.ts --project=chromium --update-snapshots",
    "test:integration:xrpl": "cross-env NODE_ENV=test vitest --run tests/integration/xrpl.live.integration.test.ts",
    "test:integration:infra": "cross-env NODE_ENV=test RUN_INFRA_REDIS_INTEGRATION_TESTS=true vitest --run tests/integration/redis.infrastructure.integration.test.ts",
    "test:load:infra": "cross-env NODE_ENV=test tsx scripts/load/redis-smoke.ts",
    "test:db:bootstrap": "bash ./scripts/verify-db-bootstrap.sh",
    "test:infra": "pnpm test:integration:infra && pnpm test:load:infra",
    "test:frontend": "pnpm test:frontend:components && pnpm test:e2e",
    "signer:wallet": "tsx services/mcp/wallet-signer.ts",
    "worker:security-alert-delivery": "tsx services/security-alert-delivery.worker.ts",
    "worker:chain-sync": "tsx services/chain-transaction-sync.worker.ts",
    "worker:signing-intents": "tsx services/signing-intent.worker.ts",
    "worker:cross-db-reconciliation": "tsx services/cross-db-reconciliation.worker.ts",
    "sync:check": "pnpm lint && pnpm typecheck && pnpm test:guardrails",
    "prisma:generate": "pnpm prisma:generate:crdb && pnpm prisma:generate:pg",
    "prisma:generate:crdb": "prisma generate --schema=prisma/crdb/schema.prisma",
    "prisma:generate:pg": "prisma generate --schema=prisma/pg/schema.prisma",
    "prisma:format": "pnpm prisma:format:crdb && pnpm prisma:format:pg",
    "prisma:format:crdb": "prisma format --schema=prisma/crdb/schema.prisma",
    "prisma:format:pg": "prisma format --schema=prisma/pg/schema.prisma",
    "prisma:migrate:deploy:pg": "prisma migrate deploy --config=prisma/pg/prisma.config.ts",
    "security:migrate-wallet-keys": "tsx scripts/migrate-wallet-encryption.ts",
    "wallet:backfill-pqc-binding-hashes": "tsx scripts/backfill-pqc-binding-hashes.ts",
    "wallet:provision:xrpl": "tsx scripts/provision-xrpl-managed-wallet.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "contracts:abi": "tsx scripts/generate-pqc-binding-registry-abi.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@noble/curves": "1.9.1",
    "@noble/post-quantum": "^0.6.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.6.0",
    "@scure/base": "1.2.6",
    "@tanstack/react-query": "5.96.2",
    "@walletconnect/ethereum-provider": "2.23.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "ethers": "6.16.0",
    "gsap": "^3.14.2",
    "mapbox-gl": "^3.18.1",
    "next-auth": "^4.24.7",
    "next-intl": "^4.7.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.17.2",
    "pino": "^10.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^5.11.0",
    "ripple-address-codec": "5.0.0",
    "viem": "2.47.10",
    "wagmi": "3.6.0",
    "xrpl": "^4.4.3",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.2.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mapbox__point-geometry": "0.1.4",
    "@types/node": "25.x",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.16.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "10.4.27",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "10.2.0",
    "jsdom": "^27.2.0",
    "knip": "^6.3.0",
    "next": "16.1.6",
    "postcss": "8.5.8",
    "prisma": "^7.3.0",
    "tailwindcss": "4.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@walletconnect/ethereum-provider": "2.23.9",
      "@walletconnect/universal-provider": "2.23.4",
      "@walletconnect/sign-client": "2.23.4",
      "abitype@1.0.8>zod": "^3.22.4",
      "@paulmillr/qr@": "0.3.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "zod"
      ],
      "ignoreMissing": [
        "zod"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bufferutil",
      "es5-ext",
      "esbuild",
      "keccak",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ],
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "@reown/appkit",
      "@swc/core"
    ]
  },
  "engines": {
    "node": ">=24.x"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
