# Copy to .env or .env.local and fill with real credentials.
# Runtime security controls
SECURITY_STRICT_MODE="true"
SECURITY_ALLOWED_ORIGINS="https://app.example.com"
AUTH_ADMIN_EMAILS="admin@example.com"
INTERNAL_API_TOKEN=""
MCP_INTERNAL_TOKEN=""
MCP_WALLET_SIGNER_TOKEN=""

# Public keys (exposed to browser)
NEXT_PUBLIC_ALCHEMY_API_KEY=""
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_SITE_URL="https://app.example.com"

# Auth config
NEXTAUTH_URL="https://app.example.com"
NEXTAUTH_SECRET=""
AUTH_INVITE_TOKEN=""

# Internal wallet encryption (server-side)
WALLET_ENCRYPTION_KEY_ACTIVE_VERSION="1"
WALLET_ENCRYPTION_KEY_V1=""
WALLET_ENCRYPTION_KEY_FINGERPRINT_V1=""
WALLET_CRYPTO_ALLOW_LEGACY="false"

# Internal wallet pipeline
EVM_RPC_URL=""
WALLET_DAILY_LIMIT_WEI=""
WALLET_ALLOWED_CHAIN_IDS=""

# Alchemy server-side settings
ALCHEMY_API_KEY=""
ALCHEMY_NETWORK="eth-mainnet"
ALCHEMY_ALLOWED_NETWORKS="eth-mainnet,base-mainnet,arbitrum-mainnet"

# Database URLs (server-side only)
COCKROACH_URL="postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require"
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:PORT/dbname"
