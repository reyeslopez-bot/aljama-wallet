# Copy to .env or .env.local and fill with real credentials.
# Runtime security controls
SECURITY_STRICT_MODE="true"
SECURITY_DISABLE_RATE_LIMIT="false"
SECURITY_RATE_LIMIT_BACKEND="memory"
SECURITY_RATE_LIMIT_REQUIRE_DISTRIBUTED="false"
SECURITY_RATE_LIMIT_REDIS_URL=""
