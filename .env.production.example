# Copy to .env.production.local for a local production-mode smoke test.
# Replace the secret and use deployment-specific database URLs in real production.
AUTH_MODE=pg
SECURITY_STRICT_MODE=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aljama_wallet
CRDB_DATABASE_URL=postgresql://root@localhost:26257/aljama_wallet?sslmode=disable
SECURITY_ALLOWED_ORIGINS=http://localhost:3000
